config.stopBubbling = true

# Jackson 3 (Spring Boot 4) ignora as anotacoes Jackson 2 geradas por @Jacksonized.
# Gerar @java.beans.ConstructorProperties no construtor para que o Jackson 3
# reconheca o creator baseado em propriedades ao desserializar os DTOs.
lombok.anyConstructor.addConstructorProperties = true
